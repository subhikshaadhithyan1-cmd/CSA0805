        print("Invalid entry skipped")
        continue
        
    fat_steps = round((fat - 3.5) / 0.1)
    snf_steps = round((snf - 8.5) / 0.1)
    
    rate = 30.00 + (fat_steps * 0.40) + (snf_steps * 0.30)
    payment = round(litres * rate, 2)
    total += payment
    
    print(f"Rate: Rs. {round(rate, 2):.2f} | Payment: Rs. {payment:.2f}")

print(f"Total Ten-Day Payment: Rs. {round(total, 2):.2f}")

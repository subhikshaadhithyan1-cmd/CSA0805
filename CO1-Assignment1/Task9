# Task 9: Complete Calculator and Automated Testing
def rate_per_litre(fat: float, snf: float) -> float:
    if not (2.0 <= fat <= 7.0):
        raise ValueError("Invalid fat: Must be between 2.0% and 7.0%")
    if not (5.0 <= snf <= 12.0):
        raise ValueError("Invalid SNF: Must be between 5.0% and 12.0%")
        
    fat_steps = round((fat - 3.5) / 0.1)
    snf_steps = round((snf - 8.5) / 0.1)
    rate = 30.00 + (fat_steps * 0.40) + (snf_steps * 0.30)
    return round(rate, 2)

def payout(litres: float, fat: float, snf: float) -> float:
    if litres < 0:
        raise ValueError("Invalid litres: Quantity cannot be negative")
    return round(litres * rate_per_litre(fat, snf), 2)

# Automated Unit Tests using assert
assert payout(10.0, 3.5, 8.5) == 300.00, "TC-01 Failed"
assert payout(8.5, 4.2, 8.7) == 283.90, "TC-02 Failed"
assert payout(12.0, 3.1, 8.3) == 333.60, "TC-03 Failed"
assert rate_per_litre(2.0, 8.5) == 24.00, "TC-04 Boundary Min Fat Failed"
assert rate_per_litre(7.0, 8.5) == 44.00, "TC-05 Boundary Max Fat Failed"

print("All assertion automated tests passed successfully!")


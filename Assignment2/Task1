def subsidy_separate(units, ration_card, elderly):
    decisions = []
    if units <= 100:
        decisions.append("Full subsidy")
    # Deliberately broad to demonstrate the overlap bug:
    if units <= 200 and ration_card:
        decisions.append("Partial subsidy")
    if units > 200 and elderly:
        decisions.append("Elderly special subsidy")
    if not decisions:
        decisions.append("No subsidy")
    return decisions


def subsidy_chain(units, ration_card, elderly):
    if units <= 100:
        return "Full subsidy"
    elif 101 <= units <= 200 and ration_card:
        return "Partial subsidy"
    elif units > 200 and elderly:
        return "Elderly special subsidy"
    else:
        return "No subsidy"


households = [
    (100, False, False), (101, True, False),
    (200, True, False), (201, False, False),
    (80, True, False), (150, False, False),
    (250, False, True), (250, True, False)
]

for household in households:
    print(household, subsidy_separate(*household), subsidy_chain(*household))

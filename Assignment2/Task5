def add_item_buggy(item, order=[]):
    order.append(item)
    return order


def add_item(item, order=None):
    if order is None:
        order = []
    order.append(item)
    return order


print(add_item_buggy("Tea"), add_item_buggy("Vada"))
print(add_item("Tea"), add_item("Vada"))

customer_1 = add_item("Tea")
customer_2 = add_item("Vada")
customer_3 = add_item("Coffee")

print(customer_1, customer_2, customer_3)
print(add_item_buggy.__defaults__)
